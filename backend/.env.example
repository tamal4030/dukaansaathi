# ---------------------------------------------------------------------------
# DukaanSaathi backend (Render web service)
# Copy to backend/.env for local development:  cp .env.example .env
# Never commit a real .env file. The server refuses to start without DATABASE_URL.
# ---------------------------------------------------------------------------

# --- Database (Supabase managed PostgreSQL) --------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# DATABASE_URL: the POOLED connection string (port 6543). The application uses
# this at runtime. Never point it at a local JSON/SQLite file in production.
#
# connection_limit: DukaanSaathi is a long-running Express service that issues
# parallel queries (the merchant overview fires nine at once), so a limit of 1
# serialises them and trips Prisma's pool timeout. 10 is a sensible default for
# a single Render instance; raise it if you scale up, and remember each
# instance opens its own pool.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
#
# DIRECT_URL: the DIRECT (non-pooled) connection string, port 5432. Prisma uses
# it for migrations. It MUST be a non-empty value: Prisma fails with P1012
# ("You must provide a nonempty direct URL") if this is empty, which blocks
# `prisma migrate deploy`.
#   Production/staging: the real Supabase direct connection string.
#   Local development:  the same URL as DATABASE_URL is acceptable.
# Never commit a real value; set it in backend/.env and in Render's dashboard.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# --- Supabase Auth ---------------------------------------------------------
# Project Settings -> API -> Project URL / anon public key
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Only needed for legacy HS256 projects. Newer Supabase projects sign JWTs with
# asymmetric keys (ES256) that are verified through the project JWKS endpoint.
SUPABASE_JWT_SECRET=""

# --- Runtime ---------------------------------------------------------------
PORT=8080
NODE_ENV=production
FRONTEND_URL="https://dukaansaathi.vercel.app"
# Comma separated list of browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS="https://dukaansaathi.vercel.app,http://localhost:5173"
# Customers must place orders with Google sign-in. Set to false only if you
# intend to allow email/password customers to order.
REQUIRE_GOOGLE_FOR_ORDERS=true

# --- DeepSeek (the ONLY LLM provider) --------------------------------------
# Read the current official DeepSeek Flash model id from
# https://api-docs.deepseek.com/quick_start/pricing and put it here.
# Leave empty to disable the assistant (the API then returns a clear
# "assistant not configured" message instead of inventing answers).
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL=""
DEEPSEEK_TIMEOUT_MS=25000

# --- Sarvam AI (speech to text / text to speech) ---------------------------
# https://dashboard.sarvam.ai -> API keys
SARVAM_API_KEY=""
# saaras:v4 is Sarvam's documented default STT model and supports `mode`.
# Verified live: mode=transcribe returns the transcript in the SPOKEN language
# (native script) and language_code=unknown auto-detects, e.g. "bn-IN".
# Do NOT set SARVAM_STT_MODE to translate/translit: that would return English
# for Bengali or Hindi speech and break the reply-language pipeline.
SARVAM_STT_MODEL="saaras:v4"
SARVAM_STT_MODE="transcribe"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_SPEAKER="ritu"

# --- Resend (transactional email, supplementary to the database) -----------
RESEND_API_KEY=""
EMAIL_FROM="DukaanSaathi <no-reply@example.com>"

# --- Limits ----------------------------------------------------------------
AI_RATE_LIMIT_PER_MINUTE=12
PUBLIC_RATE_LIMIT_PER_MINUTE=120
