# ---------------------------------------------------------------------------
# DukaanSaathi frontend (Vercel)
# Copy to frontend/.env.local for local development. Never commit real values.
# Vite only exposes variables prefixed with VITE_, and everything here ends up
# in the browser bundle: use the *anon* key only, never a service_role key.
# ---------------------------------------------------------------------------

# Base URL of the Render backend, without a trailing slash.
# Local development can leave this as /api because vite.config.ts proxies /api.
VITE_API_BASE_URL="https://dukaansaathi-api.onrender.com/api"

# Supabase project URL and anon public key (Project Settings -> API).
# Leave empty to hide Google sign-in instead of showing a broken button.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
